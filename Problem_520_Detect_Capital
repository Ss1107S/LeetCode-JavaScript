/**
 * @param {string} word
 * @return {boolean}
 */
var detectCapitalUse = function(word) {
    const firstLetterUpper = word[0] === word[0].toUpperCase();

    word = word.substring(1);

    const subUpper = word === word.toUpperCase();
    const subLower = word === word.toLowerCase();

    return firstLetterUpper ? (subUpper || subLower) : subLower;
};
