/**
 * @param {number[]} nums
 * @return {number[]}
 */
var numberGame = function(nums) {
        nums.sort((a, b) => a - b);

    const res = new Array(nums.length);

    for (let i = 0; i < nums.length; i += 2) {
        res[i] = nums[i + 1];
        res[i + 1] = nums[i];
    }

    return res;
};
