/**
 * @param {string} s
 * @return {boolean}
 */
var repeatedSubstringPattern = function(s) {
    let n = s.length;
        for (let i = 1; i <= n / 2; i++) {
        if (n % i === 0) {
            let substring = s.substring(0, i);
            if (substring.repeat(n / i) === s) {
                return true;
            }
        }
    }

    return false;
};
