class Problem_342_Power_of_Four {
     //Language JavaScript
     //Runtime 1ms
     //Memory 57.34MB

/**
 * @param {number} n
 * @return {boolean}
 */
var isPowerOfFour = function(n) {
    if (n < 1) return false;
    if (n == 1) return true;
    if (n % 4 != 0) return false;
    return isPowerOfFour(n / 4);
    };
