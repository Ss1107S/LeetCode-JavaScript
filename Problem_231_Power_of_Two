class Problem_231_Power_of_Two {
       //Language JavaScript
       //Runtime 1ms
       //Memory 57.3MB
  
/**
 * @param {number} n
 * @return {boolean}
 */
var isPowerOfTwo = function(n) {
    if (n < 1) return false;
     if (n == 1) return true;
     if (n % 2 != 0) return false;
     return isPowerOfTwo(n / 2);
};
