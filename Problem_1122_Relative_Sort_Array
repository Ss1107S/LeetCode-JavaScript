Problem_1122_Relative_Sort_Array
      //Language JavaScript
      //Runtime 1ms
      //Memory 54.38MB
/**
 * @param {number[]} arr1
 * @param {number[]} arr2
 * @return {number[]}
 */
var relativeSortArray = function(arr1, arr2) {
const count = new Array(1001).fill(0);

    for (const n of arr1) {
        count[n]++;
    }

    let i = 0;

    for (const n of arr2) {
        while (count[n] > 0) {
            arr1[i++] = n;
            count[n]--;
        }
    }

    for (let n = 0; n < count.length; n++) {
        while (count[n] > 0) {
            arr1[i++] = n;
            count[n]--;
        }
    }

    return arr1;
};
