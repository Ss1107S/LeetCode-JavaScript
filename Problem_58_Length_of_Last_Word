/**
 * @param {string} s
 * @return {number}
 */
var lengthOfLastWord = function(s) {
    let str = s.trim();
    let count = 0;
    for (let i = str.length - 1; i >= 0; i--) {
        if(str.charAt(i) != ' '){
            count++;
        }else{
            break;
        }
    } 
    return count;
};
