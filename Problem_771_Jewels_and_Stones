      //Language JavaScript
      //Runtime 2ms
      //Memory 55.80MB
/**
 * @param {string} jewels
 * @param {string} stones
 * @return {number}
 */
var numJewelsInStones = function(jewels, stones) {
      let s = 0;
          for(let i = 0; i < jewels.length; i++){
             for(let j = 0; j < stones.length; j++){
                 if(jewels.charAt(i) == stones.charAt(j)){
                     s++;
                }
            }
        }
          return s;
};
