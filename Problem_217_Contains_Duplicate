Problem_217_Contains_Duplicate
//Language JavaScript
      //Runtime 74ms
      //Memory 66.63MB
/**
 * @param {number[]} nums
 * @return {boolean}
 */
var containsDuplicate = function(nums) {
    nums.sort((a, b) => a - b);

    for (let i = 0; i < nums.length - 1; i++) {
        if (nums[i] === nums[i + 1]) {
            return true;
        }
    }

    return false;
};
