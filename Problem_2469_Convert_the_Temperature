/**
 * @param {number} celsius
 * @return {number[]}
 */
var convertTemperature = function(celsius) {
     let s = new Array(2);
    s[0] = celsius + 273.15;      // Kelvin
    s[1] = celsius * 1.8 + 32;   // Fahrenheit
    return s;
};
