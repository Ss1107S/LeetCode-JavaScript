var missingNumber = function(nums) {
     let s = nums.length;
        let totalSum = s * (s + 1) / 2;
        let sum = 0;
        let result;
        for (let i = 0; i < s; i++) { 
            sum = sum + nums[i];
            }
        return totalSum - sum; 
};
