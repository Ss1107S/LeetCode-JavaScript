/**
 * @param {number[]} nums
 * @return {number}
 */
var singleNumber = function(nums) {
    nums.sort((a, b) => a - b);

    let j = 0;
    for (let i = 1; i < nums.length; i += 2) {
        if (nums[i] !== nums[j]) {
            return nums[j];
            }
        j += 2;
    }
    return nums[j];
};
