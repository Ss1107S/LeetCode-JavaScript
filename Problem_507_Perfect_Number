Problem_507_Perfect_Number
      //Language JavaScript
      //Runtime 3ms
      //Memory 51.61MB
/**
 * @param {number} num
 * @return {boolean}
 */
var checkPerfectNumber = function(num) {
       let sum = 1;

        for (let i = 2; i * i <= num; i++) {
            if (num % i === 0) {
                if (i * i !== num) {
                    sum = sum + i + num / i;
                } else {
                    sum = sum + i;
                }
            }
        }

        if (sum === num && num !== 1) {
            return true;
        }

        return false;
};
